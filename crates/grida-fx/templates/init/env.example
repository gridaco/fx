# Provider keys for live runs. Copy this file to .env (kept out of git), then uncomment and fill
# in only the keys you use. FX reads only these names, their *_BASE_URL variables and those of
# the providers fx.yaml declares, and never prints their values.

# Grida Gateway: one key for text, images, video and 3D.
# Create it at https://console.grida.co/_/ai-gateway
# GG_API_KEY=

# Your own provider keys.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# FAL_KEY=
# TRIPO_API_KEY=
# ELEVENLABS_API_KEY=
