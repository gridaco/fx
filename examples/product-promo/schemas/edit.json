{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "opening_seconds",
    "footage_seconds",
    "closing_seconds",
    "focus",
    "editorial_note"
  ],
  "properties": {
    "opening_seconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 3.5
    },
    "footage_seconds": {
      "type": "number",
      "minimum": 6,
      "maximum": 16
    },
    "closing_seconds": {
      "type": "number",
      "minimum": 1.5,
      "maximum": 4
    },
    "focus": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "x",
          "y",
          "zoom",
          "crop"
        ],
        "properties": {
          "at": {
            "type": "number",
            "minimum": 0,
            "maximum": 16
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "zoom": {
            "type": "number",
            "minimum": 1,
            "maximum": 2.25
          },
          "crop": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "editorial_note": {
      "type": "string",
      "maxLength": 1200
    },
    "source_segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_start",
          "source_end",
          "duration_seconds"
        ],
        "properties": {
          "source_start": {
            "type": "number",
            "minimum": 0,
            "maximum": 120
          },
          "source_end": {
            "type": "number",
            "minimum": 0,
            "maximum": 120
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 16
          }
        }
      }
    }
  }
}
