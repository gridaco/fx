{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grida-fx:schema:fx-job-record-v1",
  "title": "FX job record (fx-job-record-v1)",
  "description": "A long provider job (a video, a rig) of one paid call, kept at `jobs/<key>.json` in the store (store.md) from before its request may leave until the call is answered.",
  "type": "object",
  "required": [
    "kind",
    "key",
    "capability",
    "route",
    "request",
    "take",
    "state",
    "handle"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "fx-job-record-v1"
    },
    "key": {
      "description": "The key of the call it answers (identity.md \u00a79).",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"
    },
    "route": {
      "type": "object",
      "required": [
        "id",
        "fingerprint"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "`<model>@<provider>`.",
          "type": "string",
          "pattern": "^.+@[a-z0-9._-]+$"
        },
        "fingerprint": {
          "description": "identity.md \u00a77.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "request": {
      "description": "The canonical request (identity.md \u00a79), exactly as keyed: files as `{\"file\": digest}`. It never holds a secret.",
      "type": "object"
    },
    "fresh_id": {
      "description": "The fresh invocation identity discriminator when present (identity.md §9).",
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "take": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 1
    },
    "state": {
      "description": "`submitting`: a request may be on its way. `submitted`: the provider took it under `handle`. `recoverable`: the job finished and its result still needs collection. `unavailable`: the retained job cannot deliver its result. `settled`: the attempt ended without a result. A handle from an older engine or an ambiguous project adapter outcome requires an explicit recovery check.",
      "enum": [
        "submitting",
        "submitted",
        "settled",
        "recoverable",
        "unavailable"
      ]
    },
    "handle": {
      "description": "What collecting the job needs, such as the provider's job id. Never a credential or a signed URL.",
      "type": [
        "object",
        "null"
      ]
    },
    "note": {
      "description": "A redacted reason for an uncertain submit, recoverable collection failure or unavailable result (store.md §5). Never a credential or a signed URL.",
      "type": "string"
    },
    "charged_usd": {
      "description": "The amount booked in FX's ledger for the original submission. Omitted when that amount is unknown.",
      "type": "number",
      "minimum": 0
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "engine",
            "adapter",
            "transport",
            "provider"
          ]
        },
        "phase": {
          "enum": [
            "validate",
            "upload",
            "send",
            "submit",
            "poll",
            "collect",
            "download"
          ]
        },
        "operation": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        },
        "ephemeral": {
          "type": "boolean"
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "detail": {
          "enum": [
            "available",
            "unavailable",
            "unreadable",
            "withheld"
          ]
        },
        "redacted": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "phase"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "submitting"
          }
        }
      },
      "then": {
        "properties": {
          "handle": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "submitted",
              "recoverable",
              "unavailable"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "handle": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "submitted",
              "settled"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "note"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "not": {"const": "submitting"}
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "diagnostic"
          ]
        }
      }
    },
    {
      "if": {
        "required": ["charged_usd"]
      },
      "then": {
        "properties": {
          "handle": {"type": "object"}
        }
      }
    }
  ]
}
