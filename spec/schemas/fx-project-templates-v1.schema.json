{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grida-fx:schema:fx-project-templates-v1",
  "title": "FX project templates and installable workflow starters",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "kind",
    "version",
    "templates"
  ],
  "$defs": {
    "project_file": {
      "type": "string",
      "pattern": "^(?!(?:.*/)?[.]{1,2}(?:/|$))[^/:\\\\\\u0000-\\u001f\\u007f-\\u009f]+(?:/[^/:\\\\\\u0000-\\u001f\\u007f-\\u009f]+)*$"
    }
  },
  "properties": {
    "kind": {
      "const": "fx-project-templates-v1"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "The engine version, whose release tag holds the templates."
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "dependentRequired": {
          "workflow_entry": ["prerequisites"]
        },
        "required": [
          "name",
          "description",
          "provider",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "enum": [
              "none",
              "codex",
              "gg",
              "any"
            ]
          },
          "workflow_entry": {
            "$ref": "#/$defs/project_file",
            "description": "Presence indicates that add accepts this template."
          },
          "inputs_file": {
            "$ref": "#/$defs/project_file",
            "description": "The starter's bundled input preset, when declared."
          },
          "prerequisites": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Requirements for using the starter, supplied by its author."
          },
          "source": {
            "enum": [
              "built_in",
              "release"
            ]
          }
        }
      }
    }
  }
}
