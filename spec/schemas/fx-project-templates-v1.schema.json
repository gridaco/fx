{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grida-fx:schema:fx-project-templates-v1",
  "title": "Templates init can start a project from",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "kind",
    "version",
    "templates"
  ],
  "properties": {
    "kind": {
      "const": "fx-project-templates-v1"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "The engine version, whose release tag holds the templates."
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "name",
          "description",
          "provider",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "enum": [
              "none",
              "codex",
              "gg",
              "any"
            ]
          },
          "source": {
            "enum": [
              "built_in",
              "release"
            ]
          }
        }
      }
    }
  }
}
