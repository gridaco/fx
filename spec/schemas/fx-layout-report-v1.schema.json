{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grida-fx:schema:fx-layout-report-v1",
  "title": "FX canvas layout report (fx-layout-report-v1)",
  "description": "Where the viewer places a run's or a saved plan's steps (layout.md \u00a76.11): every slot's cell and every member's order, served at the scoped `api/layout` route. The browser places its own cards in these cells and never computes one. While the viewer reads no layout file (layout.md \u00a76), a report carries automatic cells only, with `file` and `revision` null and no diagnostics.",
  "type": "object",
  "required": [
    "kind",
    "file",
    "revision",
    "state",
    "cursor",
    "diagnostics",
    "cells",
    "order"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "fx-layout-report-v1"
    },
    "file": {
      "description": "The derived project-relative POSIX path of the layout file, or null when no location is known.",
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "description": "The file digest (identity.md \u00a72) of the layout file bytes read, or null when nothing was read.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "applied",
        "none",
        "refused"
      ]
    },
    "cursor": {
      "description": "For a run, the observation cursor of the record prefix the report reflects; null for a plan.",
      "type": [
        "string",
        "null"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "unknown_step",
              "not_drawn",
              "outside_document",
              "shared_cell",
              "backward_edge",
              "displaced",
              "layout_invalid",
              "layout_location_unknown",
              "layout_location_refused"
            ]
          },
          "message": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        }
      }
    },
    "cells": {
      "description": "Every slot's address mapped to its cell in its container (layout.md \u00a74), container by container from the root. A container's frames share its cells, so an address is an unambiguous key.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "column",
          "row",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "column": {
            "type": "integer",
            "minimum": 0
          },
          "row": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "enum": [
              "automatic",
              "authored"
            ]
          }
        }
      }
    },
    "order": {
      "description": "Every member, instance ids and scope ids, in order key (layout.md \u00a74 rule 4). Only the relative order of one slot's members is meaningful.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "description": "Presentation-only note cells keyed by recorded note id, separate from executable slot cells and member order.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "column",
          "row",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "column": {
            "type": "integer",
            "minimum": 0
          },
          "row": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "enum": [
              "automatic",
              "authored"
            ]
          }
        }
      }
    },
    "values": {
      "description": "Presentation-only value cells keyed by recorded value id, separate from executable slot cells and member order.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "column",
          "row",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "column": {
            "type": "integer",
            "minimum": 0
          },
          "row": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "enum": [
              "automatic",
              "authored"
            ]
          }
        }
      }
    }
  }
}
