{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grida-fx:schema:fx-file-error-v1",
  "title": "fx-file-error-v1",
  "type": "object",
  "required": [
    "kind",
    "code",
    "message"
  ],
  "properties": {
    "kind": {
      "const": "fx-file-error-v1"
    },
    "code": {
      "enum": [
        "invalid_request",
        "invalid_source",
        "not_found",
        "stale_subject"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
