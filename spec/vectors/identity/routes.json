   ],
   "expect": [
    {"capability": "structured.generate", "route": "text-a@gg", "contract": {"adapter": "gg-structured", "adapter_behavior": 1, "pictures": "unchanged"}, "digest": "1814cc41ac8ab15a849afd5801a37b9076d2e0b382f6a7bf9278ef0fdc535e03"}
   ]
  },
