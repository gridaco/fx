{
 "kind": "fx-route-vectors-v1",
 "description": "Route tables read into a catalog (identity.md section 7): each case's builtin table stands in for the built-in default table, and its tables follow in catalog order. routes_given leaves the built-in table out of the catalog, as a --routes file does; it still serves as a base. expect lists catalog entries with their completed contract and fingerprint; absent lists routes the catalog must not hold; refuse names the table and entry that is refused, and why: no_base or other_provider.",
 "cases": [
  {
   "name": "a contract left out on a pair an adapter of FX serves is filled in",
   "note": "identity.md section 7, step 2: the adapter's name and its behaviour, typed as providers.md section 2 writes it (the string \"1\" for gg-image).",
   "builtin": [],
   "routes_given": false,
   "tables": [
    [{"capability": "image.generate", "route": "img-a@gg", "price": {"usd": 0.01}}]
   ],
   "expect": [
    {"capability": "image.generate", "route": "img-a@gg", "contract": {"adapter": "gg-image", "adapter_behavior": "1"}, "digest": "7f6238d4aa013ab3e87587914c9ee915b141d33a2432a8ff1f3a361874901b95"}
   ]
  },
  {
   "name": "the behaviour of a capability outside images is the number 1",
   "builtin": [],
   "routes_given": false,
   "tables": [
    [{"capability": "speech.generate", "route": "voice-a@elevenlabs", "price": {"usd": 0.01}, "contract": {"adapter": "elevenlabs-speech"}}]
   ],
   "expect": [
    {"capability": "speech.generate", "route": "voice-a@elevenlabs", "contract": {"adapter": "elevenlabs-speech", "adapter_behavior": 1}, "digest": "66e09f6aa6b811c7ae6e64ed83eaa6201e1972f1b066598263dfaab79f444821"}
   ]
  },
