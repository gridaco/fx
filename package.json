{
  "name": "grida-fx-web-workspace",
  "private": true,
  "homepage": "https://grida.co/fx",
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.0",
  "workspaces": ["web/viewer", "www", "web/fx-web", "web/fx-react"],
  "scripts": {
    "build:viewer": "bun --no-env-file run --cwd web/viewer build",
    "check:viewer": "bun --no-env-file run --cwd web/viewer check",
    "test:viewer": "bun --no-env-file test web/fx-web/tests",
    "test:viewer:browser": "bun --no-env-file tools/check_viewer_browser.mjs",
    "dev:viewer": "bun --no-env-file run --cwd web/viewer dev",
    "dev:www": "bun --no-env-file run --cwd www dev",
    "check:www": "bun --no-env-file run --cwd www check",
    "test:www": "bun --no-env-file run --cwd www test",
    "build:www": "bun --no-env-file run --cwd www build",
    "preview:www": "bun --no-env-file run --cwd www preview",
    "test:viewer:model-browser": "bun --no-env-file tools/check_model_browser.mjs",
    "test:viewer:media-browser": "bun --no-env-file tools/check_media_preview_browser.mjs",
    "demo:viewer:media": "uv run --project python python tools/demo_media_previews.py"
  },
  "devDependencies": {
    "playwright-core": "1.58.2"
  }
}
