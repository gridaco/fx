{
  "type": "object",
  "required": ["title", "entities", "relationships", "open_questions"],
  "properties": {
    "title": { "type": "string" },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "mode", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string" },
          "mode": { "enum": ["character", "place", "object"] },
          "description": { "type": "string" }
        }
      }
    },
    "relationships": { "type": "array", "items": { "type": "object" } },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  }
}
