/target/
# The engine tools/build_engine.py puts beside the Python SDK of a checkout.
/python/src/grida/fx/_bin/
**/node_modules/
**/__pycache__/
**/.venv/
*.pyc
.DS_Store
/js/**/dist/
/web/viewer/dist/

# Secrets never enter the repository.
.env
.env.*
!.env.example

# What running a project writes. A conformance case seeds its own store under in/.
**/.fx/
**/runs/
!conformance/*/in/.fx/
# A conformance case may hold node_modules of its own (an installed dependency, a link to a
# workspace package). The runner installs @grida/fx there, which is never committed.
!conformance/*/in/node_modules/
conformance/*/in/node_modules/@grida/
